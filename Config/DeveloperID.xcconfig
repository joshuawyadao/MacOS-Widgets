// Release settings are applied after the development defaults and ignored
// Local.xcconfig. The release command supplies the reviewed identity values.
#include "Signing.xcconfig"
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = Developer ID Application
ENABLE_HARDENED_RUNTIME = YES
DESKTOP_WIDGETS_DISTRIBUTION_CHANNEL = developer-id
DESKTOP_WIDGETS_REFRESH_COMMAND_PATH =
DESKTOP_WIDGETS_ENABLE_AUTOMATIC_REFRESH_COMMAND_PATH =
DESKTOP_WIDGETS_DISABLE_AUTOMATIC_REFRESH_COMMAND_PATH =
