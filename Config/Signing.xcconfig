// Shared signing policy. Account-specific values belong in the ignored
// Local.xcconfig file at the repository root.
CODE_SIGN_STYLE = Automatic
CODE_SIGN_IDENTITY = Apple Development
DEVELOPMENT_TEAM = $(LOCAL_DEVELOPMENT_TEAM)

// These defaults preserve existing developer builds. The friendly installer
// overrides them with stable Personal-Team-derived values in Local.xcconfig.
DESKTOP_WIDGETS_APP_BUNDLE_IDENTIFIER = com.joshuawyadao.DesktopWidgets
DESKTOP_WIDGETS_EXTENSION_BUNDLE_IDENTIFIER = com.joshuawyadao.DesktopWidgets.Widgets
WIDGET_THEME_APP_GROUP = $(DEVELOPMENT_TEAM).com.joshuawyadao.desktop-widgets
DESKTOP_WIDGETS_REFRESH_COMMAND_PATH =

#include? "../Local.xcconfig"
